# Example environment configuration for CineNavigator (React)

# TMDB (The Movie Database) API Key
# Required for fetching now playing movies and search functionality.
REACT_APP_TMDB_API_KEY=your_tmdb_api_key_here

# Google Maps API Key
# Required for map embed and Google Maps directions in the Nearby Theaters feature.
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Analytics 4 (GA4) Measurement ID
# Set this to enable GA4 event tracking (movie_added_to_watchlist, movie_searched, theater_directions_clicked).
REACT_APP_GA4_MEASUREMENT_ID=your_ga4_measurement_id_here

# --- Optional/Advanced Integration Variables (uncomment and configure as needed) ---

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# OAuth2/OpenID Connect Client ID (if enabling social login/OAuth in the future)
# REACT_APP_OAUTH_CLIENT_ID=your_oauth_client_id_here

# ------------------------------------------------------------------------
# Instructions:
# - Copy this file to `.env` and fill in your actual keys.
# - Never commit the `.env` file with sensitive keys to version control.
# - See README.md or kavia-docs/REQUIREMENTS.md for more configuration info.

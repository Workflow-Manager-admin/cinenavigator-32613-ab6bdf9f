# Example environment file for CineNavigator (copy to .env and fill in your keys)

# TMDB API Key (get from https://www.themoviedb.org)
REACT_APP_TMDB_API_KEY=your_tmdb_api_key

# Google Maps API Key (get from https://console.cloud.google.com/apis/credentials)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Analytics 4 Measurement ID (get from GA4 console)
REACT_APP_GA4_MEASUREMENT_ID=your_ga4_measurement_id
